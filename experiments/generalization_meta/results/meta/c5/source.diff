+            return component_cache[occupied]
+        labels = {}
+        label = 0
+        for start in cells:
+            if start == occupied or start in labels:
+                continue
+            labels[start] = label
+            queue = [start]
+            for p in queue:
+                for q in adjacent[p]:
+                    if q != occupied and q not in labels:
+                        labels[q] = label
+                        queue.append(q)
+            label += 1
+        component_cache[occupied] = labels
+        return labels
+
+    def pulls(crate, agent):
