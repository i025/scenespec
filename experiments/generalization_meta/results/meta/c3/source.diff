+    available = set(cells)
+    size = w * h
+    directions = ((1, 0), (0, 1), (-1, 0), (0, -1))
+
+    seed = 2166136261
+    for i, p in enumerate(sample):
+        seed = ((seed ^ ((p[0] + 1) * 131 + (p[1] + 1) * 977
+                          + i * 8191)) * 16777619) & 0xffffffff
+    seed ^= w * 65537 + h * 104729
+
+    def noise(value):
+        z = (seed ^ (value * 2654435761)) & 0xffffffff
+        z ^= z >> 16
+        z = (z * 2246822519) & 0xffffffff
+        z ^= z >> 13
+        z = (z * 3266489917) & 0xffffffff
+        z ^= z >> 16
+        return z / 4294967296.0
+
+    def manhattan(a, b):
+        return abs(a % w - b % w) + abs(a // w - b // w)
+
+    neighbors = {}
+    adjacent = {}
+    for c in cells:
+        x, y = c % w, c // w
+        row = []
+        for dx, dy in directions:
+            xx, yy = x + dx, y + dy
+            t = yy * w + xx
+            row.append(t if 0 <= xx < w and 0 <= yy < h
+                       and t in available else -1)
+        neighbors[c] = row
+        adjacent[c] = [t for t in row if t != -1]
+
+    # Walking connectivity with each possible crate cell occupied.
+    # These are ordinary floor components, not joint-state search.
+    components = {}
+    for occupied in cells:
+        labels = [-1] * size
+        component = 0
+        for start in cells:
+            if start == occupied or labels[start] != -1:
+                continue
+            labels[start] = component
+            queue = [start]
+            for u in queue:
+                for v in adjacent[u]:
+                    if v != occupied and labels[v] == -1:
+                        labels[v] = component
+                        queue.append(v)
+            component += 1
+        components[occupied] = labels
+
+    pulls = {}
+    for c in cells:
+        moves = []
+        for direction, target in enumerate(neighbors[c]):
+            if target == -1:
+                continue
+            escape = neighbors[target][direction]
+            if escape != -1:
+                moves.append((target, escape, direction))
+        pulls[c] = moves
+
+    def options(c, a):
+        labels = components[c]
+        label = labels[a]
+        return [move for move in pulls[c] if labels[move[0]] == label]
+
+    # Initialize with a two-pull certificate. Each second stance must be
