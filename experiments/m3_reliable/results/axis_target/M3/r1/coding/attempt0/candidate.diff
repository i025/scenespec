+def clamp_floor(task, values, name):
+    x0, y0, x1, y1 = floor_bounds(task, values, name)
+    x, y, yaw = values[name]
+    values[name] = [min(x1, max(x0, x)), min(y1, max(y0, y)), yaw]
+
